[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# Override curl to rewrite repository URLs for installation of App Advisor section
curl() {
  local prefix="https://packages.broadcom.com/artifactory/spring-enterprise/com/vmware/tanzu/spring/application-advisor-cli-linux/"
  for a in "$@"; do
    if [[ "$a" == "$prefix"* ]]; then
      cat >&2 <<'EOF'
  % Total    % Received % Xferd  Average Speed   Time    Time     Time  Current
                                 Dload  Upload   Total   Spent    Left  Speed
100 62.5M  100 62.5M    0     0   161M      0 --:--:-- --:--:-- --:--:--  161M
EOF
      return 0
    fi
  done
  command curl "$@"
}

tar() {
  for a in "$@"; do
    if [[ "$a" == "advisor-cli.tar" || "$a" == *"/advisor-cli.tar" ]]; then
      sleep 1
      return 0
    fi
  done
  command tar "$@"
}